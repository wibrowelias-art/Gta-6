# ---------------------------------------------------------------------------
# IMAGEFORGE environment. Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# Postgres connection string (Neon: use the pooled connection string, sslmode=require)
DATABASE_URL=
# 32+ random chars. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public base URL, e.g. http://localhost:3000 or https://imageforge.example.com
NEXT_PUBLIC_APP_URL=

# First-boot developer (only used when the user table is empty)
DEV_BOOTSTRAP_EMAIL=
DEV_BOOTSTRAP_PASSWORD=
# Step-up PIN for /dev sensitive actions (6+ digits). TOTP can be enrolled in /dev/security.
DEV_PIN=

# Image providers (any can be blank; the stub provider works offline) -------
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage: Vercel Blob in production. Blank = local ./.data/blobs folder.
BLOB_READ_WRITE_TOKEN=

# Optional ------------------------------------------------------------------
# Enables magic-link sign-in when set.
RESEND_API_KEY=
# From address for magic-link emails, e.g. "IMAGEFORGE <login@yourdomain.com>"
EMAIL_FROM=
# Protects /api/cron/retention (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=
# Billing stub: when blank, all users stay on plan quotas (free tier by default).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
